# Sunnystep SEO Agent — environment variables
# Copy to data_sources/config/.env and fill in real values (ask the previous owner privately).
# NEVER commit the real .env.

# --- Google Analytics 4 ---
GA4_PROPERTY_ID=
GA4_CREDENTIALS_PATH=./credentials/ga4-credentials.json

# --- Google Search Console ---
# Separate service account gsc-puller@sunnystep-gsc.iam.gserviceaccount.com (the GA4 account has no GSC access).
# GSC_PROPERTY is the exact API property name (Domain property, covers SG + MY).
# GSC_COUNTRY filters every query by country (ISO-3); leave empty for all countries.
# GSC_SITE_URL stays a URL: other scripts derive the site domain from it.
GSC_PROPERTY=sc-domain:sunnystep.com
GSC_COUNTRY=sgp
GSC_SITE_URL=https://www.sunnystep.com/
GSC_CREDENTIALS_PATH=./credentials/gsc-service-account.json

# --- Serper.dev (Google SERP data; replaces DataForSEO) ---
SERPER_API_KEY=
SERPER_GL=sg
SERPER_HL=en
SERPER_LOCATION=Singapore
SERPER_RESULTS_LIMIT=100

# --- Site ---
BLOG_PATH=/blogs/
COMPANY_NAME=Sunnystep
COMPANY_DOMAIN=sunnystep.com
TARGET_INDUSTRY=footwear

# --- Shopify (custom app, client_credentials grant; token auto-refreshes every 24h) ---
SHOPIFY_SHOP=gosunnystep.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-01
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_TOKEN_ISSUED_AT=
# "sunnystep blog" (the live blog with the existing articles)
SHOPIFY_BLOG_ID=94480597052

# --- Lark daily sync (Ting's Agents Control Plane) ---
# Never commit the real token. Rotate it if it was previously hardcoded.
LARK_BASE_APP_TOKEN=
LARK_MANIFEST_TABLE_ID=tbl4WOkvWqh2QXZy
LARK_REGISTRY_TABLE_ID=tbllUUb7MtE0vB60
LARK_REGISTRY_RECORD_ID=recvk3Bwf51Hzm
LARK_AGENT_FOLDER_URL=

# --- Lark review loop (/submit-for-review) ---
# Manager review group id (oc_...). Find: lark-cli im +chat-search --query "<group name>" --as bot
LARK_REVIEW_CHAT_ID=
# Optional: reviewer agent open_id, to listen only for its replies
LARK_REVIEWER_OPEN_ID=

# --- Tracking layer ---
TRACKING_ENV=development
TRACKING_DATABASE_URL=sqlite:///data/tracking.db
TRACKING_TIMEZONE=Asia/Singapore
TRACKING_LOG_LEVEL=INFO
TRACKING_DAILY_COST_CAP_USD=25
TRACKING_RUN_TIMEOUT_SECONDS=3600
TRACKING_CONFIG=config/tracking.example.yaml
OPENAI_API_KEY=
OPENAI_VISIBILITY_MODEL=gpt-4.1-mini
PERPLEXITY_API_KEY=
PERPLEXITY_VISIBILITY_MODEL=sonar
LARK_APP_ID=
LARK_APP_SECRET=
LARK_ALERT_WEBHOOK_URL=
LARK_WEEKLY_TABLE_ID=
LARK_OPPORTUNITIES_TABLE_ID=
LARK_ALERTS_TABLE_ID=

# --- Legacy (Shopline, pre-migration; not needed) ---
# SHOPLINE_STORE_HANDLE=
# SHOPLINE_ACCESS_TOKEN=
# SHOPLINE_API_VERSION=
# SHOPLINE_BLOG_COLLECTION_ID=
